# ==============================================================================
# VmPOS — Plantilla de Configuración de Variables de Entorno (.env)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copie este archivo como .env: cp .env.example .env
# 2. Defina credenciales seguras y únicas para su instalación.
# 3. NUNCA suba el archivo .env a Git ni comparta sus contraseñas.
# ==============================================================================

# Credenciales de Base de Datos Central PostgreSQL (Para Docker o Servidor Central)
POSTGRES_USER=vmpos_admin
POSTGRES_PASSWORD=CambiarPorContrasenaSeguraDeMinimo16Caracteres!
POSTGRES_DB=vmpos
POSTGRES_PORT=5433

# Puerto de la API Central de VmPOS (Por defecto 8000 para red LAN)
VMPOS_API_PORT=8000

# Clave Secreta para Tokens JWT HS256
# Si se deja vacío, el servidor genera automáticamente una clave criptográfica de 48 bytes
# y la almacena con permisos estrictos (0600) en config/jwt_secret.key
VMPOS_SECRET_KEY=
